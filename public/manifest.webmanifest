{
  "name": "wanderbar",
  "short_name": "wanderbar",
  "description": "Weather warnings for the rest of your hike: one GPX track, a pace-based ETA, and a nudge only when conditions change. Best-effort forecasts from public models; always check local information too.",
  "categories": [
    "navigation",
    "travel",
    "utilities",
    "weather"
  ],
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#eaede6",
  "theme_color": "#eaede6",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow-1-forecast.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The weather timeline for the rest of a hike, with the track's elevation profile beside it"
    },
    {
      "src": "/screenshots/narrow-3-warning.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "A warning for the hours ahead, marked on the timeline where conditions turn"
    },
    {
      "src": "/screenshots/narrow-2-map.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The route on a topographic map, with weather at each waypoint"
    },
    {
      "src": "/screenshots/wide-1-forecast.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The weather timeline for the rest of a hike, with the track's elevation profile beside it"
    },
    {
      "src": "/screenshots/wide-2-map.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The route on a topographic map, with weather at each waypoint"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "navigate-existing"
    ]
  },
  "share_target": {
    "action": "/api/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "gpx",
          "accept": [
            "application/gpx+xml",
            "application/xml",
            "text/xml",
            "application/octet-stream",
            ".gpx"
          ]
        }
      ]
    }
  }
}
