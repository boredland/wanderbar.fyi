/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanderbar",
  "main": "./dist/index.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  /**
   * Custom domain. The origin is load-bearing beyond cosmetics: the manifest's
   * share_target, the service worker scope and the push subscription are all
   * origin-bound, and MET_USER_AGENT/VAPID_SUBJECT below name this host.
   */
  "routes": [
    {
      "pattern": "wanderbar.fyi",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist"
  },
  /**
   * The only stateful resource: one push subscription plus one whole-hour
   * schedule. No D1, KV, R2, queues or cron; the DO's own alarm replaces them.
   */
  "durable_objects": {
    "bindings": [
      {
        "name": "WAKER",
        "class_name": "Waker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Waker"
      ]
    }
  ],
  "vars": {
    "MET_USER_AGENT": "wanderbar.fyi/1.0 (https://wanderbar.fyi)",
    "VAPID_SUBJECT": "mailto:admin@wanderbar.fyi",
    "VAPID_PUBLIC_KEY": "BIV7EA_6_y2KIlijRyvNglkNZ1ISrdadrFDL8mdMy4m_x4mnz5ZyE76qv6oP2-C4c7kUfg3iJF3mi3qAIQd-52w"
  }
  // VAPID_PRIVATE_KEY is a secret (the JWK `d` scalar, not pkcs8):
  //   npx wrangler secret put VAPID_PRIVATE_KEY
  // Locally it comes from .dev.vars; see .dev.vars.example.
}
